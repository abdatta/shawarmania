{
  "name": "shawarmania-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Premium brand/landing site for Shawarmania \u2014 Kalyani & Kanchrapara, West Bengal",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-weight.mjs && node worker/scripts/check-no-secret.mjs",
    "preview": "vite preview",
    "content": "echo Content portal: http://localhost:5173/admin && vite",
    "worker:assets": "node worker/scripts/build-assets.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "worker:test": "vitest run --config worker/vitest.config.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@fission-ai/openspec": "^1.6.0",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@fontsource/lilita-one": "^5.2.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-imagetools": "^10.0.1",
    "vitest": "^5.0.0",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.128.0"
  }
}
